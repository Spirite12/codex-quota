<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>codex-quota-launcher</AssemblyName>
    <RootNamespace>CodexQuota.Launcher</RootNamespace>
    <Version>0.2.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RuntimeSupport\RuntimeRequirement.cs" Link="RuntimeRequirement.cs" />
    <Compile Include="..\RuntimeSupport\UiText.cs" Link="UiText.cs" />
  </ItemGroup>

</Project>
