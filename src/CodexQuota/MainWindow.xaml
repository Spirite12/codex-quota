<Window x:Class="CodexQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="False" Focusable="False" Opacity="0"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <StackPanel Width="60" IsHitTestVisible="False">
        <StackPanel x:Name="FiveHourChip" HorizontalAlignment="Center">
            <Grid Width="36" Height="36">
                <Ellipse Fill="#FFFDFEFF" Stroke="#DFE1E5" StrokeThickness="3" Margin="2" />
                <Ellipse x:Name="FiveHourRing" StrokeThickness="3" Margin="2"
                         StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="FiveHourValue" Text="—" Foreground="#171717"
                           FontSize="14" FontWeight="Normal" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Viewbox MaxWidth="60" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                <TextBlock x:Name="FiveHourLabel" FontSize="10" Foreground="#171717" Text="5H" />
            </Viewbox>
        </StackPanel>
        <StackPanel x:Name="WeekChip" HorizontalAlignment="Center">
            <Grid Width="36" Height="36">
                <Ellipse Fill="#FFFDFEFF" Stroke="#DFE1E5" StrokeThickness="3" Margin="2" />
                <Ellipse x:Name="WeekRing" StrokeThickness="3" Margin="2"
                         StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-90" /></Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="WeekValue" Text="—" Foreground="#171717"
                           FontSize="14" FontWeight="Normal" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <Viewbox MaxWidth="60" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
                <TextBlock x:Name="WeekLabel" FontSize="10" Foreground="#171717" Text="1W" />
            </Viewbox>
        </StackPanel>
    </StackPanel>
</Window>
