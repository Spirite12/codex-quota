<Window x:Class="CodexQuota.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Quota"
        Height="36"
        SizeToContent="Width"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        Opacity="0"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        Closing="Window_Closing">
    <Grid x:Name="ChipLayout"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          IsHitTestVisible="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ChipGapColumn" Width="6" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="FiveHourChip"
                Grid.Column="0"
                Background="#FFFDFEFF"
                BorderBrush="#E1E7EF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="9,5"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="FiveHourDot" Width="7" Height="7" Fill="#B5BECA" Margin="0,0,6,0" />
                <TextBlock Text="5H：" Foreground="#667085" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="FiveHourValue" Text="—" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
        </Border>

        <Border x:Name="WeekChip"
                Grid.Column="2"
                Background="#FFFDFEFF"
                BorderBrush="#E1E7EF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="9,5"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="WeekDot" Width="7" Height="7" Fill="#B5BECA" Margin="0,0,6,0" />
                <TextBlock Text="1W：" Foreground="#667085" FontSize="12" FontWeight="SemiBold" />
                <TextBlock x:Name="WeekValue" Text="—" Foreground="#344054" FontSize="12" FontWeight="SemiBold" Margin="0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
